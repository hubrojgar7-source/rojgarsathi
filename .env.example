# Clerk (https://dashboard.clerk.com → API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# Supabase (Project Settings → API)
# NEXT_PUBLIC_SUPABASE_ANON_KEY = publishable (sb_...) OR legacy anon JWT (eyJ... role anon).
# SUPABASE_SERVICE_ROLE_KEY = secret (sb_...) OR legacy service_role JWT — server only, never NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin dashboard (/admin) — comma-separated Clerk user IDs and/or emails
ADMIN_CLERK_USER_IDS=
ADMIN_EMAILS=
